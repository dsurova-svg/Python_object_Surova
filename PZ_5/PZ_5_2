#Вариант 29, задача 2: функция Swap(X, Y) меняет местами значения
#переменных X и Y. С её помощью для чисел A, B, C, D последовательно
#меняются местами пары: A и B, C и D, B и C.


def swap(x, y):
    """Меняет местами значения x и y и возвращает их."""
    return y, x


def read_float(prompt):
    """Ввод вещественного числа с обработкой исключений."""
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print("Неправильно ввели!")


a = read_float("Введите число A: ")
b = read_float("Введите число B: ")
c = read_float("Введите число C: ")
d = read_float("Введите число D: ")

a, b = swap(a, b)   # меняем местами A и B
c, d = swap(c, d)   # меняем местами C и D
b, c = swap(b, c)   # меняем местами B и C

print(f"Новые значения: A = {a}, B = {b}, C = {c}, D = {d}")