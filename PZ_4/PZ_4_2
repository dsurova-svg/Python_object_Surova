# Дано целое число N (>0). Найти наибольшее целое число K,
# квадрат которого не превосходит N: K^2 <= N.
# Функцию извлечения квадратного корня не использовать.

n = input("Введите число N: ")
while type(n) != int:  
    try:
        n = int(n)
    except ValueError:
        print("Неправильно ввели!")
        n = input("Введите число N: ")

if n <= 0:
    print("Число должно быть положительным!")
else:
    k = 0
    while (k + 1) ** 2 <= n:
        k += 1
    print("Наибольшее число K:", k)